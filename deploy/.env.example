# 复制为 .env（cp .env.example .env），填好后再 docker compose up -d --build

# 1) 你的域名：先把它的 A 记录解析到这台 VPS 的公网 IP，再启动
MCP_DOMAIN=mcp.example.com

# 2) 微信读书 wrk- 开头的 key（只存在服务端，绝不外泄）
WEREAD_API_KEY=wrk-你的key

# 3) 手机端要用的访问口令：自己随机生成一串，务必设置（不设=裸奔）
#    生成示例： openssl rand -hex 24
MCP_AUTH_TOKEN=换成一串随机口令

# 4) 共读数据（可选）：把 tools/coread-export.py 导出的 coread.json 放进 deploy/data/，
#    再取消下面这行的注释。不配也能跑，只是看板「📖 共读」Tab 为空。
# COREAD_FILE=/data/coread.json
