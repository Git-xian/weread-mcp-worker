# 复制为 .env 后使用（npm run start:env 会自动读取）
# 注意：Node < 20.12 不支持 --env-file，请改用系统环境变量 / systemd / docker compose 注入。
WEREAD_API_KEY=wrk-你的key
MCP_AUTH_TOKEN=换成一串你自己的随机口令
PORT=8787
HOST=127.0.0.1

# 共读数据（可选）：看板「📖 共读」Tab 的来源。
# 最省事的方式是在看板上直接拖入 EPUB（会写到下面这个路径）；
# 也可以把 tools/coread-export.py 导出的 coread.json 放到服务器上再指向它。
# 不设的话默认写到 server/coread.json。
# COREAD_FILE=/srv/weread/coread.json
